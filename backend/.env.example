# Copy this file to .env in the same directory and adjust as needed.
# .env is gitignored; this example file is committed purposefully.

COGNITO_REGION="us-east-2"
COGNITO_USER_POOL_ID="us-east-2_hrmKv95ev"
COGNITO_CLIENT_ID="2b5rc445sdhleckv3ml35ol5ad"

# Option A: local docker database from docker-compose.yml.
# 1 = use local docker database, 0 = use explicit DATABASE_URL.
USE_LOCAL_DEV_DB=1

# Option B: an explicit database URL. RDS requires TLS, hence sslmode.
# The local docker database does not use TLS. If DATABASE_URL is set, USE_LOCAL_DEV_DB is ignored.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mccs?sslmode=require

# VT ARC LLM Configuration
ARC_API_KEY=your_actual_api_key_here
ARC_API_BASE=https://llm-api.arc.vt.edu/api/v1/
ARC_MODEL=gpt-oss-120b